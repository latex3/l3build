\input regression-test.tex\relax

\documentclass{minimal}

\begin{document}

\newtoks\foo % \outer

\START

\TEST{\afterassignment}{
  \def\x{\afterassignment{\edef\y{world}}\foo}
  \x={hello}
  \showthe\foo
  \show\y
}

\newpage

\showoutput

\OMIT
  % Force font loading
  \begin{verbatim}
    #$%&
  \end{verbatim}
\TIMO

\BEGINTEST{Environment test}
  \begin{verbatim}
    #$%&
  \end{verbatim}
\ENDTEST

\BEGINBOXTEST{Box test}
  \verb|#$%&|
\ENDBOXTEST

\begingroup
  \catcode`Q=4 %
  \gdef\ODD{Q}%
\endgroup

\TEST{Assertions}{%
  \ASSERT{A}{A}%
  \ASSERT{Q}{\ODD}%
  \ASSERTSTR{Q}{\ODD}%
}

\OMIT
\begin{filecontents}[noheader]{\jobname.txt}
line 1
line 2
\end{filecontents}
\TIMO

\TEST{\SHOWFILE}{
  \SHOWFILE{\jobname.txt}
  \SHOWFILE{\jobname.notfound}
}

\end{document}
